# Paddle Billing configuration. Copy to .env and fill in. Never commit the real .env.
# The site reads real environment variables first. If your host has none (e.g. shared hosting),
# put the .env file inside the private folder (salonieer-private/), never in the public web root.

# Server-side API key (Paddle > Developer tools > Authentication). Live keys start with pdl_live_apikey_.
# Permissions needed: Events (read), Customers (read), Customer portal sessions (write).
# The site pulls new events from Paddle with this key, so it works even where Paddle can't reach the site.
PADDLE_API_KEY=

# production (live account) or sandbox.
PADDLE_ENVIRONMENT=production

# Optional on hosts that block inbound requests (InfinityFree free plan): only used by /api/paddle/webhook.
# Webhook SIGNING SECRET of the notification destination (Paddle > Developer tools > Notifications >
# your destination > Edit destination > Secret key). Starts with pdl_ntfset_. This is NOT the API key.
PADDLE_WEBHOOK_SECRET=
