# Paddle Billing configuration. Copy to .env and fill in. Never commit the real .env.
# The site reads real environment variables first. If your host has none (e.g. shared hosting),
# put the .env file inside the private folder (salonieer-private/), never in the public web root.

# Server-side API key (Paddle > Developer tools > Authentication). Live keys start with pdl_live_apikey_.
# Permissions needed: Events (read), Customers (read), Customer portal sessions (write).
# The site pulls new events from Paddle with this key, so it works even where Paddle can't reach the site.
PADDLE_API_KEY=

# production (live account) or sandbox.
PADDLE_ENVIRONMENT=production

# Optional on hosts that block inbound requests (InfinityFree free plan): only used by /api/paddle/webhook.
# Webhook SIGNING SECRET of the notification destination (Paddle > Developer tools > Notifications >
# your destination > Edit destination > Secret key). Starts with pdl_ntfset_. This is NOT the API key.
PADDLE_WEBHOOK_SECRET=

# Supabase (shared with the Salonieer app). Project Settings > API > service_role key. Server-side only, never in the browser.
SUPABASE_URL=https://jauiffbyaibpdtuhgqei.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Application emails through the cPanel mailbox (SMTP 465 / IMAP 993, both TLS).
MAIL_HOST=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=METON
ADMIN_EMAIL=salonieer1st@gmail.com
# Base of payment links (Paddle's checkout), the Paddle webhook destination check and the mail server greeting.
# Links to pages in emails already use https://www.meton.work. Move this to https://www.meton.work only together with
# Paddle: approve www.meton.work as the checkout (default payment link) domain and point the notification destination
# to https://www.meton.work/api/paddle/webhook first.
SITE_URL=https://salonieer.com

# 2.46: one METON account for the website and the app (identity.php). "off" = the website signs in on its own (as before).
METON_IDENTITY=on

# Google sign-in (website). The OAuth client's redirect URI: https://www.meton.work/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phone codes by WhatsApp (Meta WhatsApp Cloud API, direct). An approved "authentication" template with the code in the
# body and a copy-code button. Without these, phone numbers can't be confirmed (booking pages take requests marked
# "phone not verified"; an added phone is kept unconfirmed and never signs in).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=meton_otp
WHATSAPP_TEMPLATE_LANG_AR=ar
WHATSAPP_TEMPLATE_LANG_EN=en
WHATSAPP_TEMPLATE_LANG_HE=he
