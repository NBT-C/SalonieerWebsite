Options -Indexes
DirectoryIndex index.php index.html
# Browsers re-check scripts and styles on every visit (a cheap 304 when unchanged), so a new upload shows up at once.
<IfModule mod_headers.c>
<FilesMatch "\.(?:js|css)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
<IfModule mod_rewrite.c>
RewriteEngine On
# METON (2026-11-06): plain http goes to https (on http the browser withholds crypto.randomUUID and the page stopped at
# "Loading…"). Page loads only (GET/HEAD), so webhooks and form posts are never redirected; Smile's /services and the
# certificate checks (/.well-known) are left exactly as they were.
RewriteCond %{HTTPS} !=on
RewriteCond %{SERVER_PORT} =80
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{REQUEST_URI} !^/(?:services|\.well-known)(?:/|$) [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteRule ^(?:data|salonieer-private|vendor|\.env[^/]*|composer\.(?:json|lock)|paddle\.php|security\.php|supabase\.php|mail\.php|cron\.php|booking\.php|billing\.php|ops\.php)(?:/|$) - [F,NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]
</IfModule>
